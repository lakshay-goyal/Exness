# Docs Service Environment Variables Template
# Documentation site (Next.js app)
# Copy this file to .env.Docs and fill in your actual values

# ==========================================
# Database Configuration
# ==========================================
# PostgreSQL connection (if docs need DB access)
DATABASE_URL=postgresql://postgresql:postgresql@postgres:5432/exness

# ==========================================
# Redis Configuration
# ==========================================
# Redis URL for caching
REDIS_URL=redis://redis:6379

# ==========================================
# MongoDB Configuration
# ==========================================
# MongoDB connection reference
MONGODB_URL=mongodb://admin:admin123@mongodb:27017/exness_snapshots?authSource=admin

# ==========================================
# Application URLs
# ==========================================
# Main frontend URL (for navigation links)
FRONTEND_URL=http://localhost:3001
# Client-side frontend URL (for back-link in docs header)
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3001
# Backend URL (for API documentation)
BACKEND_URL=http://localhost:8000

# ==========================================
# Authentication
# ==========================================
# JWT secret (if docs have protected sections)
JWT_SECRET=replace-with-secure-jwt-secret

# ==========================================
# Service Configuration
# ==========================================
# Port the docs site listens on
PORT=3000
# Node environment
NODE_ENV=production

# ==========================================
# Default User Credentials
# ==========================================
# Admin credentials reference
USER_EMAIL=admin@example.com
USER_PASSWORD=your-generated-app-password

