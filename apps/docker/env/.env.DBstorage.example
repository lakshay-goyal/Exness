# DBstorage Service Environment Variables Template
# Database storage management and archival service
# Copy this file to .env.DBstorage and fill in your actual values

# ==========================================
# Database Configuration (REQUIRED)
# ==========================================
# PostgreSQL connection for main database operations
DATABASE_URL=postgresql://postgresql:postgresql@postgres:5432/exness

# ==========================================
# Redis Configuration (REQUIRED)
# ==========================================
# Redis URL for caching and job queues
REDIS_URL=redis://redis:6379

# ==========================================
# MongoDB Configuration
# ==========================================
# MongoDB connection for snapshot storage operations
MONGODB_URL=mongodb://admin:admin123@mongodb:27017/exness_snapshots?authSource=admin

# ==========================================
# Application URLs
# ==========================================
# Frontend URL
FRONTEND_URL=http://localhost:3001
# Backend URL
BACKEND_URL=http://localhost:8000

# ==========================================
# Authentication
# ==========================================
# JWT secret for service authentication
JWT_SECRET=replace-with-secure-jwt-secret

# ==========================================
# Service Configuration
# ==========================================
# Node environment
NODE_ENV=production

# ==========================================
# External Data Sources
# ==========================================
# Binance/Backpack WebSocket URL
BINANCE_WS_URL=wss://ws.backpack.exchange/

# ==========================================
# Default User Credentials
# ==========================================
# Service authentication
USER_EMAIL=admin@example.com
USER_PASSWORD=your-generated-app-password

# ==========================================
# WebSocket Server Port
# ==========================================
# WebSocket port reference
WEBSOCKET_PORT=7070
