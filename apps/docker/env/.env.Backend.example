# Backend Service Environment Variables Template
# Copy this file to .env.Backend and fill in your actual values

# ==========================================
# Database Configuration
# ==========================================
# PostgreSQL connection string
DATABASE_URL=postgresql://postgresql:postgresql@postgres:5432/exness

# ==========================================
# Redis Configuration
# ==========================================
# Redis connection URL for caching and pub/sub
REDIS_URL=redis://redis:6379

# ==========================================
# MongoDB Configuration (for snapshots)
# ==========================================
# MongoDB connection for snapshot storage
MONGODB_URL=mongodb://admin:admin123@mongodb:27017/exness_snapshots?authSource=admin

# ==========================================
# Application URLs
# ==========================================
# Frontend application URL (for CORS and redirects)
FRONTEND_URL=http://localhost:3001
# Backend service URL (for internal communication)
BACKEND_URL=http://localhost:8000

# ==========================================
# Authentication (REQUIRED for production)
# ==========================================
# JWT secret for token signing (generate with: openssl rand -base64 32)
JWT_SECRET=replace-with-secure-jwt-secret
# Better Auth secret for session encryption
BETTER_AUTH_SECRET=replace-with-secure-better-auth-secret
# Google OAuth credentials (optional)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ==========================================
# Service Configuration
# ==========================================
# Port the backend service listens on
PORT=8000
# Node environment (development, production, test)
NODE_ENV=production

# ==========================================
# Default User Credentials (for seeding)
# ==========================================
# Admin user email
USER_EMAIL=admin@example.com
# App-specific password (not your actual email password)
USER_PASSWORD=your-generated-app-password

