# Snap Shotting Service Environment Variables Template
# Handles data snapshotting and historical data storage to MongoDB
# Copy this file to .env.Snap_Shotting and fill in your actual values

# ==========================================
# Database Configuration
# ==========================================
# PostgreSQL connection for metadata
DATABASE_URL=postgresql://postgresql:postgresql@postgres:5432/exness

# ==========================================
# Redis Configuration (REQUIRED)
# ==========================================
# Redis URL for receiving snapshot triggers
REDIS_URL=redis://redis:6379

# ==========================================
# MongoDB Configuration (REQUIRED - Primary storage)
# ==========================================
# MongoDB connection for storing snapshots
# This is the primary data store for this service
MONGODB_URL=mongodb://admin:admin123@mongodb:27017/exness_snapshots?authSource=admin

# ==========================================
# Application URLs
# ==========================================
# Frontend URL
FRONTEND_URL=http://localhost:3001
# Backend URL
BACKEND_URL=http://localhost:8000

# ==========================================
# Authentication
# ==========================================
# JWT secret for service authentication
JWT_SECRET=replace-with-secure-jwt-secret

# ==========================================
# Service Configuration
# ==========================================
# Port (required by shared config schema; unused by this worker)
PORT=8000
# Node environment
NODE_ENV=production

# ==========================================
# External Data Sources
# ==========================================
# Binance/Backpack WebSocket URL
BINANCE_WS_URL=wss://ws.backpack.exchange/

# ==========================================
# Default User Credentials
# ==========================================
# Service authentication
USER_EMAIL=admin@example.com
USER_PASSWORD=your-generated-app-password

# ==========================================
# WebSocket Server Port
# ==========================================
# WebSocket port reference
WEBSOCKET_PORT=7070
