# Websocket Server Environment Variables Template
# Real-time WebSocket server for client connections
# Copy this file to .env.Websocket_Server and fill in your actual values

# ==========================================
# Database Configuration
# ==========================================
# PostgreSQL connection string (for session/auth data)
DATABASE_URL=postgresql://postgresql:postgresql@postgres:5432/exness

# ==========================================
# Redis Configuration (REQUIRED)
# ==========================================
# Redis connection URL - used for pub/sub between services
REDIS_URL=redis://redis:6379

# ==========================================
# MongoDB Configuration
# ==========================================
# MongoDB connection for snapshot storage
MONGODB_URL=mongodb://admin:admin123@mongodb:27017/exness_snapshots?authSource=admin

# ==========================================
# Application URLs
# ==========================================
# Frontend URL (for CORS allowed origins)
FRONTEND_URL=http://localhost:3001
# Backend URL (for API proxy/validation)
BACKEND_URL=http://localhost:8000

# ==========================================
# Authentication (REQUIRED)
# ==========================================
# JWT secret for validating client tokens
JWT_SECRET=replace-with-secure-jwt-secret

# ==========================================
# Service Configuration
# ==========================================
# Node environment
NODE_ENV=production

# ==========================================
# External Data Sources
# ==========================================
# Binance/Backpack WebSocket URL
BINANCE_WS_URL=wss://ws.backpack.exchange/

# ==========================================
# Default User Credentials
# ==========================================
# Service authentication
USER_EMAIL=admin@example.com
USER_PASSWORD=your-generated-app-password

# ==========================================
# WebSocket Server Port (REQUIRED)
# ==========================================
# Port this WebSocket server listens on
WEBSOCKET_PORT=7070
PORT=7070
