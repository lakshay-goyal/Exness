# Engine Service Environment Variables Template
# Core trading engine - handles order execution and position management
# Copy this file to .env.Engine and fill in your actual values

# ==========================================
# Database Configuration
# ==========================================
# PostgreSQL connection string
DATABASE_URL=postgresql://postgresql:postgresql@postgres:5432/exness

# ==========================================
# Redis Configuration
# ==========================================
# Redis connection URL for real-time data and pub/sub
REDIS_URL=redis://redis:6379

# ==========================================
# MongoDB Configuration (for snapshots)
# ==========================================
# MongoDB connection for snapshot storage
MONGODB_URL=mongodb://admin:admin123@mongodb:27017/exness_snapshots?authSource=admin

# ==========================================
# Application URLs
# ==========================================
# Frontend application URL
FRONTEND_URL=http://localhost:3001
# Backend service URL (for API calls)
BACKEND_URL=http://localhost:8000

# ==========================================
# Authentication (REQUIRED)
# ==========================================
# JWT secret for token verification (must match backend)
JWT_SECRET=replace-with-secure-jwt-secret

# ==========================================
# Service Configuration
# ==========================================
# Node environment
NODE_ENV=production

# ==========================================
# External Data Sources
# ==========================================
# Binance/Backpack WebSocket for real-time market data
BINANCE_WS_URL=wss://ws.backpack.exchange/

# ==========================================
# Default User Credentials
# ==========================================
# Engine uses these for authentication
USER_EMAIL=admin@example.com
USER_PASSWORD=your-generated-app-password

# ==========================================
# WebSocket Server Port
# ==========================================
# Port for WebSocket server communication
WEBSOCKET_PORT=7070
