# Web Frontend Service Environment Variables Template
# Next.js web application
# Copy this file to .env.Web and fill in your actual values

# ==========================================
# Database Configuration
# ==========================================
# PostgreSQL connection (for server-side data fetching)
DATABASE_URL=postgresql://postgresql:postgresql@postgres:5432/exness

# ==========================================
# Redis Configuration
# ==========================================
# Redis URL for session storage and caching
REDIS_URL=redis://redis:6379

# ==========================================
# MongoDB Configuration
# ==========================================
# MongoDB connection for snapshot data
MONGODB_URL=mongodb://admin:admin123@mongodb:27017/exness_snapshots?authSource=admin

# ==========================================
# Application URLs (Server-side)
# ==========================================
# URL where this frontend is served (for SSR/SEO)
FRONTEND_URL=http://localhost:3001
# Backend API URL (server-side calls)
BACKEND_URL=http://localhost:8000

# ==========================================
# Authentication (REQUIRED for auth features)
# ==========================================
# JWT secret (server-side validation)
JWT_SECRET=replace-with-secure-jwt-secret
# Better Auth secret for session handling
BETTER_AUTH_SECRET=replace-with-secure-better-auth-secret
# Google OAuth credentials (optional)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ==========================================
# Service Configuration
# ==========================================
# Port this Next.js app listens on
PORT=3001
# Node environment
NODE_ENV=production

# ==========================================
# Default User Credentials
# ==========================================
# Default admin user (for seeding)
USER_EMAIL=admin@example.com
USER_PASSWORD=your-generated-app-password


# ==========================================
# CRITICAL: Build-time Variables (NEXT_PUBLIC_*)
# ==========================================
# These are baked into the client bundle at BUILD time
# They CANNOT be changed at runtime - must rebuild to change
# ==========================================

# Backend API URL that the browser/client will call
# This must be accessible from the user's browser
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Live market data is streamed directly from Binance bookTicker WebSockets in the browser.

# Documentation site URL (architecture details + interactive API explorer)
NEXT_PUBLIC_DOCS_URL=http://localhost:3000
