# Price Poller Service Environment Variables Template
# Fetches and aggregates market price data from external exchanges
# Copy this file to .env.Price_Poller and fill in your actual values

# ==========================================
# Database Configuration
# ==========================================
# PostgreSQL connection for storing price data
DATABASE_URL=postgresql://postgresql:postgresql@postgres:5432/exness

# ==========================================
# Redis Configuration (REQUIRED)
# ==========================================
# Redis URL for publishing price updates to other services
REDIS_URL=redis://redis:6379

# ==========================================
# MongoDB Configuration
# ==========================================
# MongoDB connection for snapshot storage
MONGODB_URL=mongodb://admin:admin123@mongodb:27017/exness_snapshots?authSource=admin

# ==========================================
# Application URLs
# ==========================================
# Frontend URL
FRONTEND_URL=http://localhost:3001
# Backend URL for internal API calls
BACKEND_URL=http://localhost:8000

# ==========================================
# Authentication
# ==========================================
# JWT secret for service-to-service authentication
JWT_SECRET=replace-with-secure-jwt-secret

# ==========================================
# Service Configuration
# ==========================================
# Node environment
NODE_ENV=production

# ==========================================
# External Data Sources (REQUIRED)
# ==========================================
# WebSocket URL for the exchange to poll prices from
BINANCE_WS_URL=wss://ws.backpack.exchange/

# ==========================================
# Default User Credentials
# ==========================================
# Service authentication credentials
USER_EMAIL=admin@example.com
USER_PASSWORD=your-generated-app-password

# ==========================================
# WebSocket Server Port
# ==========================================
# Port for WebSocket server (for reference)
WEBSOCKET_PORT=7070
