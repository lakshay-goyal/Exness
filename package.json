{
  "name": "with-tailwind",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "db:studio": "bun --filter @repo/db db:studio",
    "format": "prettier --write \"**/*.{ts,tsx,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,css}\"",
    "sync:docker-env": "bun scripts/sync-docker-env.ts",
    "docker:sync": "bun scripts/docker-sync.ts",
    "test:api": "bun scripts/test-api.ts"
  },
  "devDependencies": {
    "eslint": "^9.33.0",
    "knip": "^6.16.1",
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "turbo": "^2.5.8",
    "typescript-eslint": "^8.39.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.2.18",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@prisma/extension-accelerate": "^2.0.2",
    "@radix-ui/react-separator": "^1.1.7",
    "@types/bun": "^1.3.14",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.1",
    "axios": "^1.12.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lightweight-charts": "^5.0.9",
    "lucide-react": "^0.544.0",
    "nodemailer": "^7.0.6",
    "pg": "^8.16.3",
    "recharts": "^3.2.1",
    "uuid": "^13.0.0",
    "ws": "^8.18.3"
  }
}
